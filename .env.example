# ─────────────────────────────────────────────────────────────────────────────
#  VoltEdge — Environment Configuration Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=VoltEdge
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# ── Cloud Provider ────────────────────────────────────────────────────────────
CLOUD_PROVIDER=local             # local | aws | azure

# AWS (Free Tier) — only required when CLOUD_PROVIDER=aws
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_REGION=eu-west-1
AWS_S3_BUCKET=voltedge-data-dev

# Azure (Free Account) — only required when CLOUD_PROVIDER=azure
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
AZURE_CONTAINER_NAME=voltedge-data

# ── Data Ingestion ────────────────────────────────────────────────────────────
INGESTION_INTERVAL_SECONDS=60
MAX_SITES=50
API_TIMEOUT_SECONDS=30

# ── ML Models ─────────────────────────────────────────────────────────────────
FORECAST_HORIZON_HOURS=24
ANOMALY_CONTAMINATION=0.05
MODEL_RETRAIN_HOURS=168

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
DASHBOARD_DEBUG=true

# ── ESG ───────────────────────────────────────────────────────────────────────
CARBON_INTENSITY_KG_PER_KWH=0.207   # UK 2023 grid average
ESG_REPORT_CURRENCY=USD


# ── AI Assistant ──────────────────────────────────────────────────────────────
# Required for natural language energy queries via the AI assistant endpoints.
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Carbon registry (optional — dry_run=True without it)
VERRA_API_KEY=your_verra_key_here
# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console               # console (dev) | json (prod)
